{
  "expo": {
    "name": "SubTrack",
    "slug": "subtrack",
    "scheme": "subtrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAFAF7",
    "android": {
      "package": "com.reshpow.subtrack",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#2F6B5E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "com.android.vending.BILLING"
      ],
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.reshpow.subtrack",
      "supportsTablet": true
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "SubTrack",
      "shortName": "SubTrack",
      "themeColor": "#2F6B5E",
      "backgroundColor": "#FAFAF7"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2F6B5E"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-iap",
        {
          "android": {
            "store": "play"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FAFAF7",
          "dark": {
            "backgroundColor": "#111111"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Summary",
              "label": "SubTrack",
              "description": "Monthly total and next renewals",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "# Room databases (WorkManager's included) are created by reflection from their generated _Impl class.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class androidx.work.** { *; }\n# Android home-screen widget library (loaded by name from the manifest).\n-keep class com.reactnativeandroidwidget.** { *; }\n-keep class com.reshpow.subtrack.** { *; }"
          }
        }
      ],
      "./plugins/with-webview-warmup"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
